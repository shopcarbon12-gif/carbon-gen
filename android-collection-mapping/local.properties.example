# Copy to local.properties (same folder) — local.properties is gitignored.
#
# Base URL of your running ShopCarbon / carbon-gen app (no trailing path).
# Production example:
shopcarbon.api.base.url=https://app.shopcarbon.com
#
# Local dev (device/emulator): use your machine IP or 10.0.2.2 for Android emulator → host.
# shopcarbon.api.base.url=http://10.0.2.2:3000
#
# Optional: Shopify shop domain (same as web). If omitted, the server uses its default / most-recent shop.
shopify.shop.domain=your-store.myshopify.com
#
# Optional: session cookie string for POST /api/collection-mapping (paste from browser DevTools → Application → Cookies).
# You can also set this in the app under Settings → API (no rebuild).
# shopcarbon.session.cookie=

{
  "name": "carbon-gen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack && node -e \"const fs=require('fs');const path=require('path');const root=process.cwd();const src=path.join(root,'.next','static');const out=path.join(root,'.next','standalone','.next','static');if(fs.existsSync(src)){fs.mkdirSync(out,{recursive:true});fs.cpSync(src,out,{recursive:true,force:true});}const pub=path.join(root,'public');const pubOut=path.join(root,'.next','standalone','public');if(fs.existsSync(pub)){fs.mkdirSync(pubOut,{recursive:true});fs.cpSync(pub,pubOut,{recursive:true,force:true});}console.log('[build] standalone static/public synced');\"",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "dev:raw": "next dev --webpack",
    "dev:3000": "next dev --webpack -p 3000",
    "printer:bridge": "node scripts/local-printer-bridge.mjs",
    "shopify:print-bridge": "node scripts/shopify-print-bridge.mjs",
    "start": "node .next/standalone/server.js -H 0.0.0.0",
    "start:standalone": "node .next/standalone/server.js -H 0.0.0.0",
    "lint": "eslint",
    "hash-password": "node scripts/hash-password.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "check:upstash": "node scripts/check-upstash.mjs",
    "check:sync": "node scripts/check-sync.mjs",
    "check:shopify": "node scripts/check-shopify-smoke.mjs",
    "shopify:sync-accessibility-page": "node scripts/sync-shopify-accessibility-page.mjs",
    "shopify:sync-sitemap-page": "node scripts/sync-shopify-sitemap-page.mjs",
    "shopify:build-html-sitemap": "node scripts/build-html-sitemap-merge.mjs",
    "shopify:push-html-sitemap-hub": "node scripts/push-html-sitemap-hub.mjs",
    "shopify:export-catalog-urls-csv": "node scripts/export-shopify-catalog-urls-csv.mjs",
    "check:urls-canonical": "node scripts/list-shopify-urls-from-api.mjs",
    "check:urls-404": "node scripts/list-shopify-urls-from-api.mjs && node scripts/check-urls-404.mjs",
    "check:gsc-compare": "node scripts/compare-gsc-failures.mjs",
    "compare:shopify-redirects": "node scripts/compare-shopify-redirects-export.mjs",
    "match:404-products": "node scripts/match-404-products-to-catalog.mjs",
    "redirects:emit-to-add": "node scripts/emit-shopify-redirects-to-add.mjs",
    "redirects:unified": "node scripts/generate-unified-shopify-redirects.mjs",
    "match:elior-xlsx": "node scripts/match-elior-two-word-products.mjs",
    "elior:summary": "node scripts/elior-xlsx-add-summary-sheet.mjs",
    "elior:lightspeed-qty": "node scripts/elior-xlsx-lightspeed-matrix-qty.mjs",
    "lightspeed:dump-catalog-json": "node scripts/dump-lightspeed-catalog-snapshot.mjs",
    "check:gsc-redirects": "node scripts/generate-shopify-redirects-from-gsc.mjs",
    "export:gsc-404": "node scripts/export-gsc-404-batches.mjs",
    "merge:gsc-404": "node scripts/merge-gsc-404-batches.mjs",
    "fetch:404-wayback": "node scripts/fetch-404-urls-wayback.mjs",
    "push:shopify-redirects": "node scripts/push-shopify-redirects-from-csv.mjs",
    "shopify:measure-sitemap-children": "node scripts/measure-sitemap-children.mjs",
    "shopify:sync-html-sitemap-children": "node scripts/sync-shopify-html-sitemap-children.mjs",
    "shopify:rebuild-html-sitemap-children": "node scripts/rebuild-shopify-html-sitemap-children.mjs",
    "start:tunnel": "powershell -ExecutionPolicy Bypass -File scripts/start-tunnel.ps1",
    "start:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local-stack.ps1",
    "stop:local": "powershell -ExecutionPolicy Bypass -File scripts/stop-local-stack.ps1",
    "db:local:up": "docker compose -f docker-compose.local.yml up -d",
    "db:local:down": "docker compose -f docker-compose.local.yml down",
    "db:local:init": "node scripts/init-local-db.mjs",
    "backup:restore": "powershell -ExecutionPolicy Bypass -File scripts/create-restore.ps1",
    "empty:storage": "node scripts/empty-storage.mjs",
    "playwright:install": "npx playwright install",
    "playwright:install:d": "powershell -ExecutionPolicy Bypass -File scripts/playwright-d-drive.ps1 install",
    "test:e2e": "playwright test",
    "test:e2e:d": "powershell -ExecutionPolicy Bypass -File scripts/playwright-d-drive.ps1 test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:collection-mapping-kpi": "node --test --test-isolation=none tests/shopify-collection-mapping-kpi.test.mjs",
    "sync:suggestion-rules": "node scripts/sync-suggestion-rules-from-xlsx.mjs",
    "deploy:coolify": "node scripts/deploy-coolify.mjs",
    "deploy:coolify:setup": "node scripts/setup-coolify-deploy.mjs",
    "report:a11y-html": "node scripts/generate-a11y-widget-html-reports.mjs",
    "notify:test": "node scripts/notify-test.mjs",
    "notify:task-done": "powershell -ExecutionPolicy Bypass -File scripts/notify-task-complete.ps1",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.992.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.42.0",
    "@opennextjs/cloudflare": "^1.16.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "@zxing/browser": "^0.1.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "next": "16.1.6",
    "openai": "^6.22.0",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "resend": "^6.9.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "exceljs": "^4.4.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.65.0",
    "xlsx": "^0.18.5"
  }
}

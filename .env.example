APP_PASSWORD=
APP_PASSWORD_HASH=
APP_PASSWORD_HASH_PREV=
APP_PASSWORD_HASHES=
APP_USER_ID=
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD_HASH=
APP_DEFAULT_LOGIN_USERNAME=admin
AUTH_BYPASS=false

OPENAI_API_KEY=
GEMINI_API_KEY=
ALLOWED_IMAGE_HOSTS=
IMAGE_FETCH_TIMEOUT_MS=12000
IMAGE_FETCH_MAX_BYTES=10485760
# Storage: r2 (recommended for large catalogs) | supabase | auto
IMAGE_STORAGE_PROVIDER=r2
EMPTY_STORAGE_PREFIXES=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_ITEMS=items
SUPABASE_STORAGE_BUCKET_RENDERS=renders

# R2 (Cloudflare) - required for IMAGE_STORAGE_PROVIDER=r2. Works on Vercel & locally.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public URL for R2 files (custom domain or pub-xxx.r2.dev from bucket public access)
R2_PUBLIC_URL_BASE=
R2_ENDPOINT=

SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,write_products,write_files
SHOPIFY_REDIRECT_URI=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

LS_CLIENT_ID=
LS_CLIENT_SECRET=
LS_REFRESH_TOKEN=
LS_ACCOUNT_ID=
LS_DOMAIN_PREFIX=
LS_OAUTH_TOKEN_URL=
LS_API_BASE=

# Local stack canonical port (start:local + tunnel use this)
LOCAL_APP_PORT=3000

# Manual cart push email notification (Resend). Optional.
RESEND_API_KEY=
PUSH_NOTIFICATION_EMAIL=elior@carbonjeanscompany.com
# NEXT_PUBLIC_PUSH_NOTIFICATION_EMAIL=elior@carbonjeanscompany.com  # Override recipient in client
# EMAIL_FROM=notifications@yourdomain.com  # Verified domain; defaults to onboarding@resend.dev

# Meta / Instagram Graph (Carbon Social Feed app). App secret from Meta App settings → Basic (server-only).
META_APP_ID=2429351210871746
META_APP_SECRET=
# Instagram Business Account id + Page token with media permissions (see docs/instagram-meta-graph-api-setup.md)
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_PAGE_ACCESS_TOKEN=

# Meta App Review dashboard: username is fixed (meta-review@shopcarbon.com). Set password here
# for server-side upsert on startup / first POST /api/login. Prod: META_REVIEW_SEED_PASSWORD only.
# Local dev: also set META_REVIEW_AUTO_PROVISION=true or startup seed is skipped.
META_REVIEW_SEED_PASSWORD=
META_REVIEW_AUTO_PROVISION=
